{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/me/:token",
      "destination": "/api"
    },
    {
      "source": "/join/:code",
      "destination": "/join"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/evening",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/morning",
      "schedule": "0 6 * * *"
    }
  ]
}
